# Copy this file to .env (in backend/) and fill in real values before starting the server.
# NEVER commit the real .env file. It is already covered by .gitignore in this Release Bundle.

# --- Database (STAGE 2 / phase 16) ---
# These four are required. There is no fallback — the server refuses to start without them.
# This is the SAME database the live Asmara POS currently uses (srv1399.hstgr.io per the
# discovery work) — do not point this at a different database unless you mean to.
REMOTE_SERVER_HOST=srv1399.hstgr.io
REMOTE_SERVER_USER=
REMOTE_SERVER_PASSWORD=
REMOTE_SERVER_DATABASE=
DB_PORT=3306
DB_SSL=false

# --- Auth (STAGE 2 / phase 15) ---
# Generate a real, random secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not reuse the example value below for anything real.
JWT_SECRET=

# --- CORS (STAGE 2 / phase 17) ---
# Comma-separated list of additional allowed origins, beyond localhost:5101 which is always
# allowed (that's where the POS frontend itself is served from). Leave empty unless you have
# a specific reason (e.g. a web admin panel) to allow another origin.
ALLOWED_ORIGINS=

# --- Vendor integration (STAGE 2 / phase 16, extended) ---
# Fallback Authorization token sent to pos.dftech.in when a request doesn't supply its own.
# The previous hardcoded literal is used as a default ONLY so behavior is unchanged until
# this is set explicitly — set it and drop the fallback as soon as practical.
DFTECH_FALLBACK_TOKEN=

# --- GitHub auto-updater (pre-existing, unchanged by this Release Bundle) ---
GH_TOKEN=

# --- Other pre-existing values (unchanged by this Release Bundle) ---
SERVER_URL=
REMOTE_SERVER=
