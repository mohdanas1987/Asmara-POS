{
  "name": "restaurantos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "description": "RestaurantOS point-of-sale desktop shell (offline-first).",
  "author": "Asmara Restaurant, Eindhoven",
  "build": {
    "appId": "nl.asmara-eindhoven.restaurantos",
    "productName": "RestaurantOS",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "hardware.js",
      "scale.js",
      "node_modules/**/*",
      "!node_modules/**/*.{md,markdown}",
      "!node_modules/**/test/**",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../Docker-Backend-Test/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!test/**",
          "!*.sqlite",
          "!.env*"
        ]
      },
      {
        "from": "../RestaurantOS-Frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!.next/cache/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "RestaurantOS-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "electron@31.7.7": true
  }
}
